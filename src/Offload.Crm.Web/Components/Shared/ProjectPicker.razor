@inject IProjectService ProjectService

@* Project autocomplete bound to an id; optionally limited to one customer. Shows "Project (Customer)". *@
<MudAutocomplete T="ProjectLookupItem" Label="@T(Label)" Value="@_selected" ValueChanged="OnSelected"
                 SearchFunc="SearchAsync" ToStringFunc="@(p => p is null ? null : p.CustomerId == 0 ? p.Name : $"{p.Name} ({p.CustomerName})")"
                 DebounceInterval="250" ResetValueOnEmptyText="true" Clearable="@Clearable" Required="@Required"
                 Disabled="@Disabled" Error="@(ErrorText is not null)" ErrorText="@ErrorText" Variant="@Variant"
                 Margin="@Margin" Dense="true" MaxItems="20" Class="@Class" Style="@Style" data-testid="@TestId" />

@code {
    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>Raised with the full item (e.g. to fill in the project's customer).</summary>
    [Parameter]
    public EventCallback<ProjectLookupItem?> Selected { get; set; }

    [Parameter]
    public int? CustomerId { get; set; }

    [Parameter]
    public string Label { get; set; } = "Project";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Clearable { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public Margin Margin { get; set; } = Margin.None;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string TestId { get; set; } = "project-picker";

    private ProjectLookupItem? _selected;

    protected override async Task OnParametersSetAsync()
    {
        if (Value is null)
        {
            _selected = null;
        }
        else if (_selected?.Id != Value)
        {
            try
            {
                var project = await ProjectService.GetAsync(Value.Value);
                _selected = new ProjectLookupItem(project.Id, project.Name, project.CustomerId, project.CustomerName);
            }
            catch (NotFoundException)
            {
                // BUG-021: an id from a bookmark/deep link that no longer exists stays visible and clearable.
                _selected = new ProjectLookupItem(Value.Value, T("Unknown project #{0}", Value), 0, string.Empty);
            }
        }
    }

    private async Task<IEnumerable<ProjectLookupItem>> SearchAsync(string? text, CancellationToken ct) =>
        await ProjectService.LookupAsync(text, CustomerId, 20, ct);

    private async Task OnSelected(ProjectLookupItem? item)
    {
        _selected = item;
        await ValueChanged.InvokeAsync(item?.Id);
        await Selected.InvokeAsync(item);
    }
}
