@inject ICustomerService CustomerService

@* Customer autocomplete bound to an id (T-15, T-19, filters). *@
<MudAutocomplete T="LookupItem" Label="@T(Label)" Value="@_selected" ValueChanged="OnSelected"
                 SearchFunc="SearchAsync" ToStringFunc="@(c => c?.Name)" DebounceInterval="250"
                 ResetValueOnEmptyText="true" Clearable="@Clearable" Required="@Required" Disabled="@Disabled"
                 Error="@(ErrorText is not null)" ErrorText="@ErrorText" Variant="@Variant" Margin="@Margin"
                 Dense="true" MaxItems="20" Class="@Class" Style="@Style" data-testid="@TestId" />

@code {
    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>Raised with the selected item (e.g. to show its name).</summary>
    [Parameter]
    public EventCallback<LookupItem?> Selected { get; set; }

    [Parameter]
    public string Label { get; set; } = "Customer";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Clearable { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public Margin Margin { get; set; } = Margin.None;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string TestId { get; set; } = "customer-picker";

    private LookupItem? _selected;

    protected override async Task OnParametersSetAsync()
    {
        if (Value is null)
        {
            _selected = null;
        }
        else if (_selected?.Id != Value)
        {
            try
            {
                var customer = await CustomerService.GetAsync(Value.Value);
                _selected = new LookupItem(customer.Id, customer.CompanyName);
            }
            catch (NotFoundException)
            {
                // BUG-021: an id from a bookmark/deep link that no longer exists stays visible and clearable.
                _selected = new LookupItem(Value.Value, T("Unknown customer #{0}", Value));
            }
        }
    }

    private async Task<IEnumerable<LookupItem>> SearchAsync(string? text, CancellationToken ct) =>
        await CustomerService.LookupAsync(text, 20, ct);

    private async Task OnSelected(LookupItem? item)
    {
        _selected = item;
        await ValueChanged.InvokeAsync(item?.Id);
        await Selected.InvokeAsync(item);
    }
}
