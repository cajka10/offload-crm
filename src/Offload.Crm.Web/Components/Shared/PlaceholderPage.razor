@* Shown for sections that are planned for a later phase (T-06). *@
<PageTitle>@T(Title) · Offload CRM</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@T(Title)</MudText>
<MudPaper Class="pa-8 d-flex flex-column align-center text-center" Elevation="0" Outlined="true" data-testid="placeholder">
    <MudIcon Icon="@Icon" Color="Color.Primary" Style="font-size: 4rem;" Class="mb-4" />
    <MudText Typo="Typo.h6">@T("Coming soon")</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary">@T(Description)</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Construction;

    [Parameter]
    public string Description { get; set; } = "This section is under construction.";
}
