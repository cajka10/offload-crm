@inject IUserAdminService Users
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILogger<PasswordDialog> Logger

@* Reset another user's password (D-24) or change your own (then the session is refreshed via a one-time ticket). *@
<MudDialog data-testid="password-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(OwnPassword ? T("Change your password") : T("Reset password: {0}", UserName))</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm id="password-form" Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="() => _showSummary = true" novalidate>
            <FormValidator @ref="_validator" />
            @if (_showSummary)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="form-error-summary">@T("Please fix the highlighted fields.")</MudAlert>
            }
            @if (OwnPassword)
            {
                <MudTextField Label="@T("Current password")" InputType="InputType.Password" @bind-Value="_own.CurrentPassword"
                              For="@(() => _own.CurrentPassword)" AutoFocus="true" Class="mb-2" data-testid="password-current" />
                <MudTextField Label="@T("New password")" InputType="InputType.Password" @bind-Value="_own.NewPassword" For="@(() => _own.NewPassword)"
                              HelperText="@T("At least 8 characters, a digit and an uppercase letter")" Class="mb-2" data-testid="password-new" />
                <MudTextField Label="@T("Confirm new password")" InputType="InputType.Password" @bind-Value="_own.ConfirmPassword"
                              For="@(() => _own.ConfirmPassword)" data-testid="password-confirm" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">@T("Your other sessions (other browsers and devices) will be signed out.")</MudText>
            }
            else
            {
                <MudTextField Label="@T("New password")" InputType="InputType.Password" @bind-Value="_reset.Password" For="@(() => _reset.Password)"
                              HelperText="@T("At least 8 characters, a digit and an uppercase letter")" AutoFocus="true" Class="mb-2" data-testid="password-new" />
                <MudTextField Label="@T("Confirm new password")" InputType="InputType.Password" @bind-Value="_reset.ConfirmPassword"
                              For="@(() => _reset.ConfirmPassword)" data-testid="password-confirm" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    @T("{0} will be signed out everywhere. No e-mail is sent; pass the new password on in person.", UserName)
                </MudText>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_saving" data-testid="dialog-cancel">@T("Cancel")</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="password-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                   data-testid="dialog-save">@T(OwnPassword ? "Change password" : "Reset password")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null = change your own password.</summary>
    [Parameter]
    public string? UserId { get; set; }

    [Parameter]
    public string? UserName { get; set; }

    private readonly ChangeOwnPasswordInput _own = new();
    private readonly PasswordResetInput _reset = new();
    private object _model = default!;
    private FormValidator? _validator;
    private bool _saving;
    private bool _showSummary;

    private bool OwnPassword => UserId is null;

    protected override void OnInitialized() => _model = OwnPassword ? _own : _reset;

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _showSummary = false;
        try
        {
            if (OwnPassword)
            {
                var ticket = await Users.ChangeOwnPasswordAsync(_own);
                Snackbar.Add("Your password was changed.", Severity.Success);
                var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
                Navigation.NavigateTo($"account/refresh?ticket={ticket}&ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            }
            else
            {
                await Users.ResetPasswordAsync(UserId!, _reset);
                Snackbar.Add($"The password of {UserName} was reset.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (AppValidationException ex)
        {
            _validator?.Show(ex.Errors);
            _showSummary = true;
        }
        catch (NotFoundException)
        {
            Snackbar.Add("This user no longer exists.", Severity.Error);
            MudDialog.Cancel();
        }
        catch (SessionExpiredException)
        {
        }
        catch (ForbiddenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password change failed");
            Snackbar.Add("The password could not be changed. Please try again.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
