@page "/settings"
@inject IProjectStatusService StatusService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<SettingsPage> Logger
@inject Offload.Crm.Web.Auth.AdminGuard AdminGuard

<PageTitle>@T("Settings") · Offload CRM</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@T("Settings")</MudText>

<MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="@T("Project statuses")" data-testid="tab-statuses">
        <div class="d-flex align-center flex-wrap gap-2 mb-3">
            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                @T("Statuses appear in this order in every status dropdown. \"Active\" statuses count as active projects; \"Closed\" statuses are terminal (e.g. Delivered, Cancelled).")
                @if (!_isAdmin)
                {
                    <span data-testid="statuses-readonly"> @T("Only administrators can change them.")</span>
                }
            </MudText>
            @if (_isAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync"
                       data-testid="status-new">@T("New status")</MudButton>
            }
        </div>

        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" data-testid="loading" />
        }
        else if (_loadError)
        {
            <MudAlert Severity="Severity.Error" data-testid="load-error">
                @T("Statuses could not be loaded.") <MudLink OnClick="LoadAsync" Typo="Typo.body2">@T("Try again")</MudLink>
            </MudAlert>
        }
        else if (_statuses.Count == 0)
        {
            <div class="list-state" data-testid="empty-state">
                <MudText>@T("No project statuses yet.")</MudText>
                @if (_isAdmin)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Class="mt-3">@T("New status")</MudButton>
                }
            </div>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="list-table" data-testid="status-table">
                <thead>
                    <tr>
                        @if (_isAdmin)
                        {
                            <th>@T("Order")</th>
                        }
                        <th>@T("Color")</th>
                        <th>@T("Name")</th>
                        <th>@T("Flags")</th>
                        <th class="hide-lt-600" style="text-align: right;">@T("Projects")</th>
                        @if (_isAdmin)
                        {
                            <th class="col-actions">@T("Actions")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _statuses.Count; i++)
                    {
                        var s = _statuses[i];
                        var index = i;
                        <tr @key="s.Id" data-testid="status-row">
                            @if (_isAdmin)
                            {
                            <td class="col-nowrap">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0 || _busy)"
                                               aria-label="@T("Move up")" OnClick="() => MoveAsync(s, true)" data-testid="status-up" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == _statuses.Count - 1 || _busy)"
                                               aria-label="@T("Move down")" OnClick="() => MoveAsync(s, false)" data-testid="status-down" />
                            </td>
                            }
                            <td><span class="color-swatch" style="@($"background: {s.Color};")" title="@s.Color"></span></td>
                            <td data-testid="status-name-cell"><ProjectStatusChip Name="@s.Name" Color="@s.Color" /></td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (s.IsActive)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Class="ma-0">@T("Active")</MudChip>
                                    }
                                    @if (s.IsClosed)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="ma-0">@T("Closed")</MudChip>
                                    }
                                    @if (s.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="ma-0" data-testid="status-default-chip">@T("Default")</MudChip>
                                    }
                                </div>
                            </td>
                            <td class="hide-lt-600" style="text-align: right;">@s.ProjectCount</td>
                            @if (_isAdmin)
                            {
                            <td class="col-actions">
                                @if (!s.IsDefault && !s.IsClosed)
                                {
                                    <MudTooltip Text="@T("Set as default")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small" aria-label="@T("Set as default")" Disabled="_busy"
                                                       OnClick="() => SetDefaultAsync(s)" data-testid="status-make-default" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="@T("Edit")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@T("Edit status")"
                                                   OnClick="() => EditAsync(s)" data-testid="status-edit" />
                                </MudTooltip>
                                <MudTooltip Text="@T("Delete")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T("Delete status")"
                                                   OnClick="() => DeleteAsync(s)" data-testid="status-delete" />
                                </MudTooltip>
                            </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>
    <MudTabPanel Text="@T("General")" data-testid="tab-general">
        <GeneralPanel />
    </MudTabPanel>
    @if (_isAdmin)
    {
        @* D-27: administrators only (also enforced server-side). *@
        <MudTabPanel Text="@T("Database")" data-testid="tab-database">
            <DatabasePanel />
        </MudTabPanel>
        <MudTabPanel Text="@T("Users")" data-testid="tab-users">
            <UsersPanel />
        </MudTabPanel>
    }
</MudTabs>

@code {
    private IReadOnlyList<ProjectStatusDto> _statuses = [];
    private bool _loading = true;
    private bool _loadError;
    private bool _busy;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AdminGuard.IsAdminAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = false;
        try
        {
            _statuses = await StatusService.ListAsync();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            Logger.LogError(ex, "Loading statuses failed");
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        var dialog = await DialogService.ShowAsync<ProjectStatusEditDialog>("New status", DialogExtensions.FormOptions(MaxWidth.Small));
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task EditAsync(ProjectStatusDto status)
    {
        var parameters = new DialogParameters<ProjectStatusEditDialog> { { x => x.Existing, status } };
        var dialog = await DialogService.ShowAsync<ProjectStatusEditDialog>("Edit status", parameters, DialogExtensions.FormOptions(MaxWidth.Small));
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private Task MoveAsync(ProjectStatusDto status, bool up) => RunAsync(() => StatusService.MoveAsync(status.Id, up), null);

    private Task SetDefaultAsync(ProjectStatusDto status) =>
        RunAsync(() => StatusService.SetDefaultAsync(status.Id), $"\"{status.Name}\" is now the default status.");

    private async Task DeleteAsync(ProjectStatusDto status)
    {
        if (!await DialogService.ConfirmDeleteAsync("Delete status", $"Delete the status \"{status.Name}\"?"))
        {
            return;
        }

        await RunAsync(() => StatusService.DeleteAsync(status.Id), $"Status \"{status.Name}\" deleted.");
    }

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await action();
            if (success is not null)
            {
                Snackbar.Add(success, Severity.Success);
            }
        }
        catch (ConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (NotFoundException)
        {
            Snackbar.Add("This status no longer exists.", Severity.Info);
        }
        catch (ForbiddenException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (SessionExpiredException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Status action failed");
            Snackbar.Add("The action failed. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }
}
