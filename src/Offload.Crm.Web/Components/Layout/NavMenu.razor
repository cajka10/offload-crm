<MudNavMenu Color="Color.Primary" Bordered="true" Class="pt-2" aria-label="@T("Main navigation")">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" data-testid="nav-dashboard">@T("Dashboard")</MudNavLink>
    <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business" data-testid="nav-customers">@T("Customers")</MudNavLink>
    <MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Work" data-testid="nav-projects">@T("Projects")</MudNavLink>
    <MudNavLink Href="/tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TaskAlt" data-testid="nav-tasks">@T("Tasks")</MudNavLink>
    <MudNavLink Href="/activities" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventNote" data-testid="nav-activities">@T("Activities")</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings" data-testid="nav-settings">@T("Settings")</MudNavLink>
</MudNavMenu>
