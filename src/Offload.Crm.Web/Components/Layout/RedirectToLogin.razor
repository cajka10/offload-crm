@inject NavigationManager Navigation

@* The circuit's user is no longer authenticated (session revalidation failed): go to the login page. *@
@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"account/login?expired=1&ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
