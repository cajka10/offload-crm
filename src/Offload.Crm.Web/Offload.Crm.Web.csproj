<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local connection strings (with passwords) live in user secrets, never in the repository. -->
    <UserSecretsId>offload-crm-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offload.Crm.Infrastructure\Offload.Crm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offload.Crm.Tests" />
  </ItemGroup>

</Project>
